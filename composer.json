{
    "name": "libertjeremy/symfony-security-helpers-bundle",
    "type": "symfony-bundle",
    "authors": [
        {
            "name": "libertjeremy",
            "email": "contact@libertjeremy.fr"
        }
    ],
    "require": {
        "php": "^8.3",
        "libertjeremy/symfony-config-helpers": "^1.0.2",
        "libertjeremy/symfony-security-helpers": "^1.1",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-core": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "LibertJeremy\\Symfony\\SecurityHelpersBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LibertJeremy\\Symfony\\SecurityHelpersBundle\\Tests\\": "tests/"
        }
    }
}
